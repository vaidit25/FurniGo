<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:id="@+id/main"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!-- Header Text -->
    <TextView
        android:id="@+id/tv_otp_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OTP Verification"
        android:textSize="24sp"
        android:textColor="#000000"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="16dp" />

    <!-- Subtitle Text -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_otp_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter the Code sent on"
            android:textSize="14sp"
            android:textColor="#1D1D1D"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:paddingStart="24dp"
            android:paddingEnd="5dp" />

        <TextView
            android:id="@+id/phone_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#1D1D1D"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:text="45212145"/>

<!--        <ImageButton-->
<!--            android:id="@+id/edit_phone"-->
<!--            android:src="@drawable/img"-->
<!--            android:layout_width="25dp"-->
<!--            android:layout_height="25"/>-->



    </LinearLayout>



    <LinearLayout
        android:id="@+id/linearOtp"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <!-- OTP Input Field -->
        <EditText
            android:id="@+id/et_otp1"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="3dp"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/et_otp2"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="3dp"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/et_otp3"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="3dp"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/et_otp4"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>


    <!-- Resend OTP -->
    <TextView
        android:id="@+id/tv_resend_otp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resend OTP"
        android:textSize="14sp"
        android:textColor="#007BFF"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="16dp" />

    <!-- Submit Button -->
    <Button
        android:id="@+id/btn_verifild"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:text="V E R I F Y"
        android:backgroundTint="#007BFF"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:paddingVertical="12dp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="8dp" />

</LinearLayout>
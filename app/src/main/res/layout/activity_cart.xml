<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pin"
    tools:context=".CartActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/empty"
            android:visibility="gone"
            android:layout_marginTop="300dp"
            android:gravity="center"
            android:orientation="vertical">

            <com.airbnb.lottie.LottieAnimationView
                android:layout_width="280dp"
                android:layout_height="280dp"
                app:lottie_rawRes="@raw/emptycartanimation"
                app:lottie_autoPlay="true"
                app:lottie_loop="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="25sp"
                android:text="Oops!!! No Products"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/nonempty"
            android:orientation="vertical">

            <LinearLayout
                android:layout_gravity="center"
                android:background="@color/HomeToolbarBtmNvVewClr"
                android:layout_width="match_parent"
                android:paddingVertical="10dp"
                android:layout_height="50dp">

                <ImageView
                    android:id="@+id/Back"
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:layout_marginStart="20dp"
                    android:src="@drawable/baseline_arrow_back_24" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="115dp"
                    android:fontFamily="@font/fontawesome"
                    android:layout_gravity="center_horizontal"
                    android:text="My Cart"
                    android:textColor="@color/black"
                    android:textSize="25dp"
                    android:textStyle="bold" />


            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                app:cardCornerRadius="10dp"
                android:background="@color/white"
                android:layout_marginTop="10dp"
                android:elevation="10dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcylCart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:id="@+id/couponCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="10dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/offericon"
                        android:layout_marginStart="20dp"
                        android:layout_gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apply Offer"
                        android:textColor="@color/black"
                        android:textSize="20dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="20dp"
                        android:fontFamily="@font/fontawesome"/>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="160dp"
                        android:src="@drawable/arrow" />

                </LinearLayout>

                <LinearLayout
                    android:weightSum="100"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="20dp"
                    android:layout_marginTop="40dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:id="@+id/layoutUser"
                        android:layout_weight="90"
                        android:layout_marginHorizontal="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="Apply Code"
                        app:endIconMode="clear_text"
                        app:boxStrokeColor="@color/black"
                        app:boxStrokeWidth="1sp"
                        app:hintTextColor="@color/black"
                        app:endIconTint="#18671B"
                        app:startIconTint="#18671B">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="normal"
                            />

                    </com.google.android.material.textfield.TextInputLayout>

                    <Button

                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:text="APPLY"
                        android:layout_marginBottom="5dp"
                        android:backgroundTint="@color/ThemeTextClr"
                        android:textColor="@color/white"

                        android:id="@+id/applyoffer"/>
                </LinearLayout>



            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="10dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/paymenticon"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="25dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Payment Options"
                        android:textColor="@color/black"
                        android:textSize="20dp"
                        android:layout_marginTop="-25dp"
                        android:layout_marginStart="70dp"
                        android:fontFamily="@font/fontawesome"/>


                    <RadioGroup
                        android:id="@+id/rdbPayment"
                        android:weightSum="100"
                        android:paddingHorizontal="15dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbtnCOD"
                            android:layout_width="0dp"
                            android:layout_weight="50"
                            android:layout_height="40dp"
                            android:background="@drawable/radio_selector"
                            android:button="@android:color/transparent"
                            android:checked="true"
                            android:elevation="5dp"
                            android:layout_marginEnd="5dp"
                            android:text="Cash on Delivery"
                            android:textAlignment="center"
                            android:textSize="16dp" />

                        <RadioButton
                            android:id="@+id/rbtnOnline"
                            android:layout_width="0dp"
                            android:layout_weight="50"
                            android:layout_height="40dp"
                            android:background="@drawable/radio_selector"
                            android:button="@android:color/transparent"
                            android:elevation="5dp"
                            android:text="Pay Online"
                            android:layout_marginStart="5dp"
                            android:textAlignment="center"
                            android:textSize="16dp" />


                    </RadioGroup>
                </LinearLayout>



            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:id="@+id/deliveryaddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="10dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="10dp">

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:src="@drawable/paymenticon"
                            android:layout_gravity="center"
                            android:layout_marginStart="25dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Delivery Address"
                            android:textColor="@color/black"
                            android:textSize="20dp"
                            android:layout_gravity="center"
                            android:layout_marginStart="20dp"
                            android:fontFamily="@font/archivo"/>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/arrow"
                            android:layout_marginStart="110dp"
                            android:layout_gravity="center"/>

                    </LinearLayout>



                    <androidx.cardview.widget.CardView
                        android:id="@+id/addressCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="5dp"
                        android:layout_marginTop="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/addressType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Home Delivery"
                                android:layout_marginStart="15dp"
                                android:layout_marginTop="15dp"
                                android:textSize="17dp"
                                android:textColor="@color/black"/>

                            <TextView
                                android:id="@+id/tvChangeAddress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Add/Change Address"
                                android:layout_marginStart="90dp"
                                android:layout_marginTop="13dp"
                                android:textSize="14dp"
                                android:textColor="@color/blueColor"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="35dp"
                            android:orientation="vertical">


                            <TextView
                                android:id="@+id/address"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="No Address"
                                android:layout_marginStart="15dp"
                                android:layout_marginTop="15dp"
                                android:textSize="14dp"
                                />


                            <TextView
                                android:id="@+id/phoneNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="9879085586"
                                android:layout_marginStart="15dp"
                                android:layout_marginTop="15dp"
                                android:layout_marginBottom="15dp"
                                android:textSize="15dp"
                                android:textColor="@color/black"/>

                            <!--                            <Button-->
                            <!--                                android:id="@+id/btnSaveAddress"-->
                            <!--                                android:layout_width="wrap_content"-->
                            <!--                                android:layout_height="wrap_content"-->
                            <!--                                android:text="Save Address"/>-->
                        </LinearLayout>



                    </androidx.cardview.widget.CardView>




                </LinearLayout>



            </androidx.cardview.widget.CardView>



            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="10dp"
                android:layout_marginBottom="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/fontawesome"
                            android:text="Item Total"
                            android:textColor="@color/black"
                            android:textSize="18dp" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="15dp"
                            android:layout_marginStart="180dp"
                            android:layout_marginTop="17dp"
                            android:src="@drawable/rupee" />


                        <TextView
                            android:id="@+id/tvitem_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="12000"
                            android:textColor="@color/black"
                            android:textSize="18dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="20dp"
                            android:text="GST"
                            android:textColor="@color/black"
                            android:textSize="18dp" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="15dp"
                            android:layout_marginStart="228dp"
                            android:layout_marginTop="27dp"
                            android:src="@drawable/rupee" />

                        <TextView
                            android:id="@+id/tvDeliveryCharge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="5%"
                            android:textColor="@color/black"
                            android:textSize="18dp"
                            android:layout_marginStart="1dp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="20dp"
                            android:text="Coupon Offer"
                            android:textColor="@color/black"
                            android:textSize="18dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="136dp"
                            android:layout_marginTop="20dp"
                            android:text="-"
                            android:textStyle="bold"
                            android:textColor="@color/blueColor"
                            android:textSize="20dp" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="15dp"
                            android:layout_marginStart="0dp"
                            android:layout_marginTop="28dp"
                            android:src="@drawable/rupee" />

                        <TextView
                            android:id="@+id/tvCouponOffer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="0"
                            android:textColor="@color/blueColor"
                            android:textSize="18dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="20dp"
                            android:text="Total"
                            android:textColor="@color/black"
                            android:textSize="18dp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="15dp"
                            android:layout_marginStart="220dp"
                            android:layout_marginTop="25dp"
                            android:src="@drawable/rupee" />

                        <TextView
                            android:id="@+id/tvtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="12000"
                            android:textColor="@color/black"
                            android:textSize="18dp"
                            android:layout_marginStart="0dp"
                            android:textStyle="bold"/>

                    </LinearLayout>



                    <Button
                        android:id="@+id/btnCheckout"
                        android:layout_gravity="center"
                        android:layout_width="match_parent"
                        android:layout_marginHorizontal="40dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Checkout"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/blueColor"
                        android:textColor="@color/white"
                        android:textSize="18dp"
                        android:layout_marginBottom="10dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


        </LinearLayout>


    </LinearLayout>

</androidx.core.widget.NestedScrollView>
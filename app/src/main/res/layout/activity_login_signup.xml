<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E1F1F8"
    tools:context=".utils.Login_Signup">



    <FrameLayout
        android:id="@+id/frameLayout2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="@string/furnigo"
            android:textColor="#2E0842"
            android:textSize="60dp"
            android:textStyle="bold" />

        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="match_parent"
            android:layout_height="250dp"
            app:lottie_rawRes="@raw/loginsinup"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            android:layout_marginTop="70dp"
            android:layout_marginBottom="20dp"
            android:elevation="50dp"
            android:layout_gravity="center"/>

    </FrameLayout>

    <TextView
        android:id="@+id/smart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Smart Furniture for Smarter Living."
        android:textColor="@color/black"
        android:textSize="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/frameLayout2"/>

    <TextView
        android:id="@+id/welcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="Welcome User"
        android:textColor="#2E0842"
        android:textSize="50sp"
        android:textStyle="bold|normal"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/smart"
        app:layout_constraintVertical_bias="0.474" />

    <RelativeLayout
        android:id="@+id/relativeLayout3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E1F1F8"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent">


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="5sp"
            app:cardCornerRadius="15sp"
            app:cardElevation="10sp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15sp">


                <LinearLayout
                    android:id="@+id/loginLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible"
                    android:padding="5sp">

                    <TextView
                        android:id="@+id/login"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="5sp"
                        android:text="Login"
                        android:textAlignment="viewStart"
                        android:textColor="#2E0842"
                        android:textSize="20sp"
                        android:textStyle="bold" />


                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="5sp"
                        android:layout_marginTop="5sp"
                        android:hint="Email ID"
                        app:boxStrokeColor="@color/black"
                        app:boxStrokeWidth="1sp"
                        app:hintTextColor="@color/black"
                        app:shapeAppearanceOverlay="@style/btn1">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etemail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/email_va"
                            android:drawablePadding="5sp"
                            android:ems="10"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="normal" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="5sp"
                        android:layout_marginTop="5sp"
                        android:hint="Password"
                        app:boxStrokeColor="@color/black"
                        app:boxStrokeWidth="1sp"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#2E0842"
                        app:hintTextColor="@color/black"
                        app:shapeAppearance="@style/btn1">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etpassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/lock_va"
                            android:drawablePadding="5sp"
                            android:ems="10"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="normal"/>

                    </com.google.android.material.textfield.TextInputLayout>


                    <TextView
                        android:id="@+id/forgotP"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left"
                        android:layout_marginVertical="5sp"
                        android:layout_marginStart="230sp"
                        android:text="Forgot Password?"
                        android:textColor="#FF3D00"
                        android:textColorHint="@color/black"
                        tools:ignore="TouchTargetSizeCheck" />

                    <!--                <TextView-->
                    <!--                    android:id="@+id/forgot"-->
                    <!--                    android:layout_width="match_parent"-->
                    <!--                    android:layout_height="wrap_content"-->
                    <!--                    android:layout_marginHorizontal="25sp"-->
                    <!--                    android:layout_marginTop="3sp"-->
                    <!--                    android:text="Forgot password ?"-->
                    <!--                    android:textStyle="bold"-->
                    <!--                    android:textAlignment="textEnd"-->
                    <!--                    android:textColor="#397ACA" />-->

                    <Button
                        android:id="@+id/btnlogin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="30sp"
                        android:backgroundTint="#2E0842"
                        android:text="Login"
                        android:textAllCaps="false"
                        android:textSize="22sp"
                        app:cornerRadius="20dp" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10sp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvdont"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="Don't have account? "
                            android:textColor="#3C3B3B"
                            android:textFontWeight="@integer/material_motion_duration_short_1"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvsignup"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="Signup now"
                            android:textColor="@color/blueColor"
                            android:textSize="15sp" />

                    </LinearLayout>

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/signupLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="5dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/switchsignup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Create An Account"
                        android:textAlignment="viewStart"
                        android:textColor="#2E0842"
                        android:textSize="26sp"
                        android:textStyle="bold" />


                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="5sp"
                        android:layout_marginTop="5sp"
                        android:hint="Username"
                        app:boxStrokeColor="@color/black"
                        app:boxStrokeWidth="1sp"
                        app:hintTextColor="@color/black"
                        app:shapeAppearanceOverlay="@style/btn1">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/username"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/person_va"
                            android:drawablePadding="5sp"
                            android:ems="10"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="normal" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="5sp"
                        android:layout_marginTop="5sp"
                        android:hint="Email Id"
                        app:boxStrokeColor="@color/black"
                        app:boxStrokeWidth="1sp"
                        app:hintTextColor="@color/black"
                        app:shapeAppearanceOverlay="@style/btn1">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/email"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/email_va"
                            android:drawablePadding="5sp"
                            android:ems="10"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="normal" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="5sp"
                        android:layout_marginTop="5sp"
                        android:hint="Phone no"
                        app:boxStrokeColor="@color/black"
                        app:boxStrokeWidth="1sp"
                        app:shapeAppearanceOverlay="@style/btn1">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/mobileno"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/phone_va"
                            android:drawablePadding="5sp"
                            android:ems="10"
                            android:inputType="phone"
                            android:maxLines="1"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="normal" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="5sp"
                        android:layout_marginTop="5sp"
                        android:hint="Password"
                        app:boxStrokeColor="@color/black"
                        app:boxStrokeWidth="1sp"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#2E0842"
                        app:shapeAppearanceOverlay="@style/btn1">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/lock_va"
                            android:drawablePadding="5sp"
                            android:ems="10"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="normal" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <Button
                        android:id="@+id/btnsignup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="30sp"
                        android:layout_marginVertical="10sp"
                        android:backgroundTint="#2E0842"
                        android:text="Submit"
                        android:textAllCaps="false"
                        android:textSize="22sp"
                        app:cornerRadius="20sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/already"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="Already have an account? "
                            android:textColor="#3C3B3B"
                            android:textFontWeight="@integer/material_motion_duration_short_1"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvlogin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Login now"
                            android:textColor="@color/blueColor"
                            android:textSize="15sp" />

                    </LinearLayout>


                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>


    </RelativeLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
